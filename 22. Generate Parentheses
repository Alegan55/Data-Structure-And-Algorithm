class Solution {
public:
    void generator(vector<string>&res,int open,int close,string s)
    {
        
      if(open==0 && close==0)
      {
        res.push_back(s);
        return;
      }
     if(open>0)
     generator(res,open-1,close,s+"(");
     if(close>0 &&open<close)
     generator(res,open,close-1,s+")");
    }
    vector<string> generateParenthesis(int n) {
        
        vector<string>res;
        generator(res,n,n,"");
        return res;

    }
};
