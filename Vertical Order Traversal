#include <vector>
#include <queue>
#include <unordered_map>
#include <algorithm>

using namespace std;

// Definition for a binary tree node provided by LeetCode
struct TreeNode {
    int val;
    TreeNode *left;
    TreeNode *right;
    TreeNode() : val(0), left(nullptr), right(nullptr) {}
    TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
    TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
};

class Solution {
public:
    vector<vector<int>> verticalOrder(TreeNode* root) {
        vector<vector<int>> result;
        if (!root) return result;

        // Map to group node values by their column index
        unordered_map<int, vector<int>> col_map;
        
        // Queue to store pair of (Node, Column Index)
        queue<pair<TreeNode*, int>> q;
        q.push({root, 0});

        // Track the bounds of column indices to avoid sorting keys later
        int min_col = 0, max_col = 0;

        while (!q.empty()) {
            auto [node, col] = q.front();
            q.pop();

            // Store the node value under its respective column index
            col_map[col].push_back(node->val);

            // Dynamically update the leftmost and rightmost column bounds
            min_col = min(min_col, col);
            max_col = max(max_col, col);

            // Process the left child (column decreases by 1)
            if (node->left) {
                q.push({node->left, col - 1});
            }
            // Process the right child (column increases by 1)
            if (node->right) {
                q.push({node->right, col + 1});
            }
        }

        // Gather columns linearly from the leftmost column to the rightmost column
        for (int i = min_col; i <= max_col; ++i) {
            if (col_map.count(i)) {
                result.push_back(col_map[i]);
            }
        }

        return result;
    }
};
