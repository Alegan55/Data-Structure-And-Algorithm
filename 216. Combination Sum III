class Solution {
public:
void solve(int i,int n,int k,vector<int>&v, vector<vector<int>>&ans)
{
    if(n==0 && k==0)
    {
        ans.push_back(v);
        return;
    }
    if(i>9)return;
    if(n<0 || k<0)return;
    v.push_back(i);
    solve(i+1,n-i,k-1,v,ans);
    v.pop_back();
    solve(i+1,n,k,v,ans);
}
    vector<vector<int>> combinationSum3(int k, int n) {
        vector<int>v;
          vector<vector<int>>ans;
          solve(1,n,k,v,ans);
          return ans;
    }
};
